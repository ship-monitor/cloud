# HTTP server port
PORT=6767
# Database connection string. Only postgres databases supported
DB_DSN='user=cloud-db-user password=password host=localhost port=5430 dbname=cloud-db sslmode=disable'
# Security key is used for authentication service
SECURITY_KEY='some-secret'
# NATS broker url
NATS_URL=nats://localhost:4222
# Valkey storage url
VALKEY_URL=localhost:6379
