# HTTP server port
PORT=6767
# Database driver, supports 'postgres' and 'sqlite'
DB_DRIVER=sqlite
# Database connection string. Specific for driver
DB_DSN='./ship-cloud.sqlite3'
# Security key is used for authentication service
SECURITY_KEY='some-secret'
# NATS broker url
NATS_URL=nats://localhost:4222
# Valkey storage url
VALKEY_URL=localhost:6379
