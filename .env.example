# Application mode, any value that contains 'DEV' treats as enabling development mode. Default is "DEVELOPMENT"
MODE="DEVELOPMENT"
# HTTP server port
PORT=6767
# Database connection string. Only postgres databases supported
DB_DSN='user=cloud-db-user password=password host=localhost port=5430 dbname=cloud-db sslmode=disable'
# CORS Origins, CORS system enabled only in development mode
CORS_ORIGINS='http://localhost:5137,http://127.0.0.1:5173'
# Security key is used for authentication service
SECURITY_KEY='some-secret'
# NATS broker url
NATS_URL=nats://localhost:4222
# Valkey storage url
VALKEY_URL=localhost:6379
# Clickhouse sorage url
CLICKHOUSE_DSN=clickhouse://metrics-user:password@localhost:9000/metrics
