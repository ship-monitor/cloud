definition user {}

definition hub {
    relation owner: user
    relation administrator: user
    relation viewer: user

    permission view = owner + administrator + viewer
    permission manage = owner + administrator + viewer
    permission disconnect = owner
    permission share = owner + administrator
}

definition device {
    relation hub: hub

    relation owner: user
    relation administrator: user
    relation viewer: user

    permission view = owner + administrator + viewer + hub->view
    permission view_state = owner + administrator + viewer + hub->view
    permission send_command = owner + administrator + hub->manage
    permission disconnect = owner + hub->manage
    permission rename = owner + administrator + hub->manage
    permission share = owner + administrator + hub->manage
}
